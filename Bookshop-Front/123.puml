@startuml
actor User
participant "Browser (Fetch API)" as JS
participant "OrderController" as Controller
participant "OrderService" as Service
database "PostgreSQL" as DB

User -> JS : Click "Place Order"
JS -> Controller : POST /api/orders (JWT Token)
Controller -> Service : createOrder(dto)
Service -> DB : Check Stock & Save Order
DB --> Service : Order Saved
Service --> Controller : OrderDTO
Controller --> JS : 201 Created
JS -> User : Show Success Message
@enduml
