@startuml
left to right direction
skinparam packageStyle rectangle

actor User
actor Admin

rectangle "Book-shop" {
  usecase "Register" as UC_Reg
  usecase "Login" as UC_Login
  usecase "Browse Catalog" as UC_Browse
  usecase "Search & Filter" as UC_Search
  usecase "Manage Cart (Add/Remove)" as UC_Cart
  usecase "Checkout" as UC_Checkout
  usecase "View Order History" as UC_History
  
  usecase "Manage Products" as UC_MngProd
  usecase "Manage Orders" as UC_MngOrd
  usecase "Manage Users" as UC_MngUsers
}

User --> UC_Reg
User --> UC_Login
User --> UC_Browse
User --> UC_Search
User --> UC_Cart
User --> UC_Checkout
User --> UC_History

UC_Checkout ..> UC_Login : <<include>>

Admin --> UC_Login
Admin --> UC_MngProd
Admin --> UC_MngOrd
Admin --> UC_MngUsers
@enduml